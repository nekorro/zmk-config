//                                                         ▀▀▀   █   ▀▀▀   █   ▀▀▀   ▀   ▀▀▀
//                                                               █      ▄▄▄█▄▄▄    █   █  
//                                                               ▀      █  █  █     █▄█
//                                                             ▀▀▀▀▀    █  █  █      ▀
//                                                                      ▀  ▀  ▀
//
// ▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

/ {
    behaviors {
        KP_DOT_SHIFT_COMMA: KP_DOT_SHIFT_COMMA {
            compatible = "zmk,behavior-mod-morph";
            label = "KP_DOT_SHIFT_COMMA";
            bindings = <&kp RBKT>, <&kp LBKT>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        KP_COLON_SHIFT_SEMICOLON: KP_COLON_SHIFT_SEMICOLON {
            compatible = "zmk,behavior-mod-morph";
            label = "KP_COLON_SHIFT_SEMICOLON";
            bindings = <&kp LS(RBKT)>, <&kp LS(LBKT)>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        UBER_DOT: UBER_DOT {
            compatible = "zmk,behavior-mod-morph";
            label = "UBER_DOT";
            bindings = <&KP_DOT_SHIFT_COMMA>, <&KP_COLON_SHIFT_SEMICOLON>;

            #binding-cells = <0>;
            mods = <(MOD_LALT|MOD_RALT)>;
        };

        caps_word_shift: caps_word_shift {
            compatible = "zmk,behavior-tap-dance";
            label = "CAPS_WORD_SHIFT";
            #binding-cells = <0>;
            bindings = <&kp LEFT_SHIFT>, <&caps_word>;
        };

        sticky_forever: sticky_forever {
            compatible = "zmk,behavior-sticky-key";
            label = "STICKY_FOREVER";
            bindings = <&kp>;
            #binding-cells = <1>;
            release-after-ms = <3000000>;
            ignore-modifiers;
            quick-release;
        };

        sm_ctrl: sm_ctrl {
            compatible = "zmk,behavior-mod-morph";
            label = "SM_CTRL";
            bindings = <&td_sticky_ctrl>, <&release LCTRL>;

            #binding-cells = <0>;
            mods = <(MOD_LCTL)>;
            keep-mods = <(MOD_LCTL)>;
        };

        sm_shift: sm_shift {
            compatible = "zmk,behavior-mod-morph";
            label = "SM_SHIFT";
            bindings = <&td_sticky_shift>, <&release LEFT_SHIFT>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT)>;
            keep-mods = <(MOD_LSFT)>;
        };

        sm_alt: sm_alt {
            compatible = "zmk,behavior-mod-morph";
            label = "SM_ALT";
            bindings = <&td_sticky_alt>, <&release LEFT_ALT>;

            #binding-cells = <0>;
            mods = <(MOD_LALT)>;
            keep-mods = <(MOD_LALT)>;
        };

        sm_gui: sm_gui {
            compatible = "zmk,behavior-mod-morph";
            label = "SM_GUI";
            bindings = <&td_sticky_gui>, <&release LEFT_GUI>;

            #binding-cells = <0>;
            mods = <(MOD_LGUI)>;
            keep-mods = <(MOD_LGUI)>;
        };

        td_sticky_ctrl: td_sticky_ctrl {
            compatible = "zmk,behavior-tap-dance";
            label = "TD_STICKY_CTRL";
            #binding-cells = <0>;
            bindings = <&sticky_forever LCTRL>, <&hold_forever LCTRL>;
        };

        td_sticky_shift: td_sticky_shift {
            compatible = "zmk,behavior-tap-dance";
            label = "TD_STICKY_SHIFT";
            #binding-cells = <0>;
            bindings = <&sticky_forever LEFT_SHIFT>, <&hold_forever LEFT_SHIFT>;
        };

        td_sticky_alt: td_sticky_alt {
            compatible = "zmk,behavior-tap-dance";
            label = "TD_STICKY_ALT";
            #binding-cells = <0>;
            bindings = <&sticky_forever LEFT_ALT>, <&hold_forever LEFT_ALT>;
        };

        td_sticky_gui: td_sticky_gui {
            compatible = "zmk,behavior-tap-dance";
            label = "TD_STICKY_GUI";
            #binding-cells = <0>;
            bindings = <&sticky_forever LEFT_GUI>, <&hold_forever LEFT_GUI>;
        };
    };

    combos {
        compatible = "zmk,combos";

        extra-nav-left {
            bindings = <&mo 4>;
            key-positions = <34 33>;
        };

        extra-nav-right {
            bindings = <&mo 4>;
            key-positions = <36 35>;
        };

        LANG {
            bindings = <&kp CAPS>;
            key-positions = <32 37>;
        };

        Btn {
            bindings = <&mo 5>;
            key-positions = <33 36>;
        };
    };

    macros {
        release: release {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings =
                <&macro_release>,
                <&macro_param_1to1 &kp MACRO_PLACEHOLDER>;

            label = "RELEASE";
        };

        la: la {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings =
                <&macro_release>,
                <&kp LCTRL &kp LEFT_ALT &kp LEFT_GUI &kp LEFT_SHIFT>,
                <&macro_press>,
                <&macro_param_1to1 &mo MACRO_PLACEHOLDER>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&macro_param_1to1 &mo MACRO_PLACEHOLDER>;

            label = "LA";
        };

        hold_forever: hold_forever {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings =
                <&macro_press>,
                <&macro_param_1to1 &kp MACRO_PLACEHOLDER>;

            label = "HOLD_FOREVER";
        };

        hold_mod_tap_key: hold_mod_tap_key {
            compatible = "zmk,behavior-macro-two-param";
            #binding-cells = <2>;
            bindings =
                <&macro_press>,
                <&macro_param_1to1 &kp MACRO_PLACEHOLDER &macro_param_2to1>,
                <&macro_tap>,
                <&kp MACRO_PLACEHOLDER>;

            label = "HOLD_MOD_TAP_KEY";
        };

        wintab: wintab {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LEFT_ALT>,
                <&macro_tap>,
                <&kp TAB>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&kp LEFT_ALT>;

            label = "WINTAB";
        };

        mactab: mactab {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LEFT_GUI>,
                <&macro_tap>,
                <&kp TAB>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&kp LEFT_GUI>;

            label = "MACTAB";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        Base {
            bindings = <
         &kp Q  &kp W  &kp E             &kp R  &kp T        &kp Y  &kp U  &kp I      &kp O    &kp P
         &kp A  &kp S  &kp D             &kp F  &kp G        &kp H  &kp J  &kp K      &kp L    &kp SEMI
&kp TAB  &kp Z  &kp X  &kp C             &kp V  &kp B        &kp N  &kp M  &kp COMMA  &kp DOT  &kp FSLH  &UBER_DOT
                       &caps_word_shift  &la 3  &kp SPACE    &mo 2  &la 1  &kp RALT
            >;

            label = "Base";
        };

        Num {
            bindings = <
           &kp KP_N1  &kp KP_N2       &kp KP_N3      &kp KP_N4       &kp KP_N5          &kp KP_N6  &kp KP_N7  &kp KP_N8  &kp KP_N9  &kp KP_N0
           &kp F11    &kp LEFT_ARROW  &kp UP_ARROW   &kp DOWN_ARROW  &kp RIGHT_ARROW    &kp F12    &sm_ctrl   &sm_shift  &sm_alt    &sm_gui
&kp MINUS  &kp F1     &kp F2          &kp F3         &kp F4          &kp F5             &kp F6     &kp F7     &kp F8     &kp F9     &kp F10    &UBER_DOT
                                      &kp BACKSPACE  &kp DELETE      &kp ENTER          &trans     &trans     &trans
            >;

            label = "Num";
        };

        Sym {
            bindings = <
          &kp N1         &kp N2         &kp N3         &kp N4      &kp N5             &kp N6            &kp RA(COMMA)  &kp LS(RBKT)  &kp LS(LBKT)   &kp SEMI
          &kp N7         &kp GRAVE      &kp RA(DOT)    &kp N9      &kp RA(LS(DOT))    &kp LS(RA(FSLH))  &kp N0         &kp RA(FSLH)  &kp LS(GRAVE)  &kp RBKT
&kp PIPE  &kp BACKSLASH  &kp RA(GRAVE)  &kp UNDER      &kp EQUAL   &kp RA(O)          &kp RA(P)         &kp PLUS       &kp MINUS     &kp N8         &kp RA(BSLH)  &kp LBKT
                                        &kp BACKSPACE  &kp DELETE  &kp ENTER          &trans            &trans         &trans
            >;

            label = "Sym";
        };

        Nav {
            bindings = <
        &wintab           &mactab            &trans         &kp PRINTSCREEN  &kp ESC      &trans    &trans         &trans     &trans     &trans
        &sm_gui           &sm_alt            &sm_shift      &sm_ctrl         &kp ENTER    &kp LEFT  &kp DOWN       &kp UP     &kp RIGHT  &trans
&trans  &kp LG(LC(LEFT))  &kp LG(LC(RIGHT))  &kp BACKSPACE  &kp DELETE       &trans       &kp HOME  &kp PAGE_DOWN  &kp PG_UP  &kp END    &trans  &kp KP_NUM
                                             &trans         &trans           &trans       &trans    &trans         &trans
            >;

            label = "Nav";
        };

        ExtNav {
            bindings = <
        &trans  &trans          &trans        &trans          &trans             &trans          &trans          &trans        &trans           &trans
        &trans  &kp LEFT_ARROW  &kp UP_ARROW  &kp DOWN_ARROW  &kp RIGHT_ARROW    &kp LEFT_ARROW  &kp DOWN_ARROW  &kp UP_ARROW  &kp RIGHT_ARROW  &trans
&trans  &trans  &kp HOME        &kp PAGE_UP   &kp PAGE_DOWN   &kp END            &kp HOME        &kp PAGE_DOWN   &kp PAGE_UP   &kp END          &trans  &trans
                                &trans        &trans          &trans             &trans          &trans          &trans
            >;

            label = "ExtNav";
        };

        Button {
            bindings = <
        &kp KP_NUMLOCK  &trans  &trans  &trans  &trans    &kp C_VOL_UP  &kp C_BRI_UP  &kp C_AC_DESKTOP_SHOW_ALL_WINDOWS  &trans  &bt BT_SEL 0
        &trans          &trans  &trans  &trans  &trans    &kp C_VOL_DN  &kp C_BRI_DN  &trans                             &trans  &bt BT_SEL 1
&tog 6  &trans          &trans  &trans  &trans  &trans    &kp C_MUTE    &trans        &trans                             &trans  &bt BT_SEL 2  &bt BT_CLR_ALL
                                &trans  &trans  &trans    &trans        &trans        &trans
            >;

            label = "Button";
        };

        Game {
            bindings = <
         &kp ESCAPE        &kp Q  &kp X         &kp E  &kp R        &trans  &trans          &trans          &trans           &trans
         &kp LEFT_SHIFT    &kp A  &kp W         &kp D  &kp F        &trans  &kp LEFT_ARROW  &kp UP_ARROW    &kp RIGHT_ARROW  &trans
&kp TAB  &kp LEFT_CONTROL  &kp Z  &kp S         &kp C  &kp V        &trans  &trans          &kp DOWN_ARROW  &trans           &trans  &to 0
                                  &kp LEFT_ALT  &mo 7  &kp SPACE    &trans  &trans          &trans
            >;

            label = "Game";
        };

        Game+ {
            bindings = <
         &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp NUMBER_4  &kp NUMBER_5    &trans  &trans  &trans  &trans  &kp LC(RA(DEL))
         &kp NUMBER_6  &kp NUMBER_7  &kp NUMBER_8  &kp NUMBER_9  &kp NUMBER_0    &kp F5  &trans  &trans  &trans  &trans
&kp TAB  &kp Y         &kp U         &kp I         &kp O         &kp P           &trans  &trans  &trans  &trans  &trans           &kp LA(F4)
                                     &trans        &trans        &trans          &trans  &trans  &trans
            >;

            label = "Game+";
        };
    };

    conditional_layers { compatible = "zmk,conditional-layers"; };
};
