//                                                                      ▀  ▀  ▀
//
// ▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄

#include "keys_ru.h"
#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>

&mt {
    quick-tap-ms = <150>;
    flavor = "tap-preferred";
    require-prior-idle-ms = <150>;
};

/ {
    behaviors {
        KP_DOT_SHIFT_COMMA: KP_DOT_SHIFT_COMMA {
            compatible = "zmk,behavior-mod-morph";
            label = "KP_DOT_SHIFT_COMMA";
            bindings = <&kp RBKT>, <&kp LBKT>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        KP_COLON_SHIFT_SEMICOLON: KP_COLON_SHIFT_SEMICOLON {
            compatible = "zmk,behavior-mod-morph";
            label = "KP_COLON_SHIFT_SEMICOLON";
            bindings = <&kp LS(RBKT)>, <&kp LS(LBKT)>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        UBER_DOT: UBER_DOT {
            compatible = "zmk,behavior-mod-morph";
            label = "UBER_DOT";
            bindings = <&KP_DOT_SHIFT_COMMA>, <&KP_COLON_SHIFT_SEMICOLON>;

            #binding-cells = <0>;
            mods = <(MOD_LALT|MOD_RALT)>;
        };

        caps_word_shift: caps_word_shift {
            compatible = "zmk,behavior-tap-dance";
            label = "CAPS_WORD_SHIFT";
            #binding-cells = <0>;
            bindings = <&kp LEFT_SHIFT>, <&caps_word>;
        };

        sticky_forever: sticky_forever {
            compatible = "zmk,behavior-sticky-key";
            label = "STICKY_FOREVER";
            bindings = <&kp>;
            #binding-cells = <1>;
            release-after-ms = <3000000>;
            ignore-modifiers;
            quick-release;
        };

        sm_ctrl: sm_ctrl {
            compatible = "zmk,behavior-mod-morph";
            label = "SM_CTRL";
            bindings = <&td_sticky_ctrl>, <&release LCTRL>;

            #binding-cells = <0>;
            mods = <(MOD_LCTL)>;
            keep-mods = <(MOD_LCTL)>;
        };

        sm_shift: sm_shift {
            compatible = "zmk,behavior-mod-morph";
            label = "SM_SHIFT";
            bindings = <&td_sticky_shift>, <&release LEFT_SHIFT>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT)>;
            keep-mods = <(MOD_LSFT)>;
        };

        sm_alt: sm_alt {
            compatible = "zmk,behavior-mod-morph";
            label = "SM_ALT";
            bindings = <&td_sticky_alt>, <&release LEFT_ALT>;

            #binding-cells = <0>;
            mods = <(MOD_LALT)>;
            keep-mods = <(MOD_LALT)>;
        };

        sm_gui: sm_gui {
            compatible = "zmk,behavior-mod-morph";
            label = "SM_GUI";
            bindings = <&td_sticky_gui>, <&release LEFT_GUI>;

            #binding-cells = <0>;
            mods = <(MOD_LGUI)>;
            keep-mods = <(MOD_LGUI)>;
        };

        td_sticky_ctrl: td_sticky_ctrl {
            compatible = "zmk,behavior-tap-dance";
            label = "TD_STICKY_CTRL";
            #binding-cells = <0>;
            bindings = <&sticky_forever LCTRL>, <&hold_forever LCTRL>;
        };

        td_sticky_shift: td_sticky_shift {
            compatible = "zmk,behavior-tap-dance";
            label = "TD_STICKY_SHIFT";
            #binding-cells = <0>;
            bindings = <&sticky_forever LEFT_SHIFT>, <&hold_forever LEFT_SHIFT>;
        };

        td_sticky_alt: td_sticky_alt {
            compatible = "zmk,behavior-tap-dance";
            label = "TD_STICKY_ALT";
            #binding-cells = <0>;
            bindings = <&sticky_forever LEFT_ALT>, <&hold_forever LEFT_ALT>;
        };

        td_sticky_gui: td_sticky_gui {
            compatible = "zmk,behavior-tap-dance";
            label = "TD_STICKY_GUI";
            #binding-cells = <0>;
            bindings = <&sticky_forever LEFT_GUI>, <&hold_forever LEFT_GUI>;
        };

        th_sticky: th_sticky {
            compatible = "zmk,behavior-hold-tap";
            label = "TH_STICKY";
            bindings = <&hold_forever>, <&sticky_forever>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            flavor = "tap-preferred";
        };

        en_dot: en_dot {
            compatible = "zmk,behavior-mod-morph";
            label = "EN_DOT";
            bindings = <&kp DOT>, <&kp COMMA>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        en_gui_dot: en_gui_dot {
            compatible = "zmk,behavior-hold-tap";
            label = "EN_GUI_DOT";
            bindings = <&kp>, <&en_dot>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <150>;
            require-prior-idle-ms = <150>;
            flavor = "tap-preferred";
        };
    };

    combos {
        compatible = "zmk,combos";

        extra-nav-left {
            bindings = <&mo 0>;
            key-positions = <34 33>;
        };

        extra-nav-right {
            bindings = <&mo 0>;
            key-positions = <36 35>;
        };

        LANG {
            bindings = <&kp CAPS>;
            key-positions = <32 37>;
        };

        Btn {
            bindings = <&mo 0>;
            key-positions = <33 36>;
        };

        cmbru {
            bindings = <&layer_ru>;
            key-positions = <2 3>;
            layers = <0>;
        };

        cmben {
            bindings = <&layer_en>;
            key-positions = <2 3>;
            layers = <1>;
        };
    };

    macros {
        release: release {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings =
                <&macro_release>,
                <&macro_param_1to1 &kp MACRO_PLACEHOLDER>;

            label = "RELEASE";
        };

        la: la {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings =
                <&macro_release>,
                <&kp LCTRL &kp LEFT_ALT &kp LEFT_GUI &kp LEFT_SHIFT>,
                <&macro_press>,
                <&macro_param_1to1 &mo MACRO_PLACEHOLDER>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&macro_param_1to1 &mo MACRO_PLACEHOLDER>;

            label = "LA";
            wait-ms = <5>;
            tap-ms = <5>;
        };

        hold_forever: hold_forever {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings =
                <&macro_press>,
                <&macro_param_1to1 &kp MACRO_PLACEHOLDER>;

            label = "HOLD_FOREVER";
        };

        hold_mod_tap_key: hold_mod_tap_key {
            compatible = "zmk,behavior-macro-two-param";
            #binding-cells = <2>;
            bindings =
                <&macro_press>,
                <&macro_param_1to1 &kp MACRO_PLACEHOLDER &macro_param_2to1>,
                <&macro_tap>,
                <&kp MACRO_PLACEHOLDER>;

            label = "HOLD_MOD_TAP_KEY";
        };

        wintab: wintab {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LEFT_ALT>,
                <&macro_tap>,
                <&kp TAB>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&kp LEFT_ALT>;

            label = "WINTAB";
        };

        mactab: mactab {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LEFT_GUI>,
                <&macro_tap>,
                <&kp TAB>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&kp LEFT_GUI>;

            label = "MACTAB";
        };

        to_ru: to_ru {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LS(LC(N2))>;
            label = "TO_RU";
            wait-ms = <0>;
            tap-ms = <30>;
        };

        to_en: to_en {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LS(LC(N1))>;
            label = "TO_EN";
            wait-ms = <0>;
            tap-ms = <30>;
        };

        layer_ru: layer_ru {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&to 1 &to_ru>;
            label = "LAYER_RU";
            wait-ms = <0>;
            tap-ms = <30>;
        };

        layer_en: layer_en {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&to 0 &to_en>;
            label = "LAYER_EN";
            wait-ms = <0>;
            tap-ms = <30>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        en {
            bindings = <
                &kp Q  &kp W  &kp E      &kp R  &kp T        &kp Y    &kp U  &kp I      &kp O    &kp P
                &kp A  &kp S  &kp D      &kp F  &kp G        &kp H    &kp J  &kp K      &kp L    &kp SEMI
&mt LSHIFT TAB  &kp Z  &kp X  &kp C      &kp V  &kp B        &kp N    &kp M  &kp COMMA  &kp DOT  &kp FSLH  &en_gui_dot LEFT_GUI 0
                              &kp LCTRL  &mo 4  &kp SPACE    &kp RET  &mo 2  &kp LALT
            >;

            display-name = "En";
            label = "En";
        };

        ru {
            bindings = <
                &kp RU_CYRILLIC_SHORT_I  &kp RU_CYRILLIC_TSE   &kp RU_CYRILLIC_U   &kp RU_CYRILLIC_KA  &kp RU_CYRILLIC_IE    &kp RU_CYRILLIC_EN  &kp RU_CYRILLIC_GHE        &kp RU_CYRILLIC_SHA  &kp RU_CYRILLIC_ZE  &kp RU_CYRILLIC_HA
                &kp RU_CYRILLIC_EF       &kp RU_CYRILLIC_YERU  &kp RU_CYRILLIC_VE  &kp RU_CYRILLIC_A   &kp RU_CYRILLIC_PE    &kp RU_CYRILLIC_ER  &kp RU_CYRILLIC_O          &kp RU_CYRILLIC_EL   &kp RU_CYRILLIC_DE  &kp RU_CYRILLIC_ZHE
&mt LSHIFT TAB  &kp RU_CYRILLIC_YA       &kp RU_CYRILLIC_CHE   &kp RU_CYRILLIC_ES  &kp RU_CYRILLIC_EM  &kp RU_CYRILLIC_I     &kp RU_CYRILLIC_TE  &kp RU_CYRILLIC_SOFT_SIGN  &kp RU_CYRILLIC_BE   &kp RU_CYRILLIC_YU  &kp RU_CYRILLIC_E    &mt LGUI RU_PERIOD
                                                               &kp LCTRL           &la 3               &kp SPACE             &mo 2               &la 1                      &kp LALT
            >;

            display-name = "Ru";
            label = "Ru";
        };

        sym {
            bindings = <
        &kp EXCL    &kp AT         &kp HASH       &kp LBKT        &kp GRAVE            &kp PLUS   &kp N7  &kp N8  &kp N9  &kp ASTRK
        &kp DOLLAR  &kp PERCENT    &kp LESS_THAN  &kp LPAR        &kp DOUBLE_QUOTES    &kp MINUS  &kp N4  &kp N5  &kp N6  &kp N0
&trans  &kp CARET   &kp AMPERSAND  &kp SEMI       &kp LEFT_BRACE  &kp SINGLE_QUOTE     &kp EQUAL  &kp N1  &kp N2  &kp N3  &kp SLASH  &trans
                                   &trans         &la 3           &trans               &trans     &trans  &trans
            >;

            label = "Sym";
        };

        fn {
            bindings = <
        &trans  &trans  &trans  &trans  &trans    &trans  &kp F9  &kp F10  &kp F11  &kp F12
        &trans  &trans  &trans  &trans  &trans    &trans  &kp F5  &kp F6   &kp F7   &kp F8
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &kp F1  &kp F2   &kp F3   &kp F4   &trans
                        &trans  &trans  &trans    &trans  &trans  &trans
            >;

            label = "Fn";
        };

        nav {
            bindings = <
        &trans  &trans  &trans         &trans      &kp ESC    &kp INSERT      &trans          &trans        &trans           &trans
        &trans  &trans  &trans         &trans      &kp RET    &kp LEFT_ARROW  &kp DOWN_ARROW  &kp UP_ARROW  &kp RIGHT_ARROW  &trans
&trans  &trans  &trans  &kp BACKSPACE  &kp DELETE  &trans     &kp HOME        &kp PAGE_DOWN   &kp PAGE_UP   &kp END          &trans  &trans
                        &trans         &trans      &trans     &trans          &la 3           &trans
            >;

            label = "Nav";
        };
    };

    conditional_layers { compatible = "zmk,conditional-layers"; };
};
