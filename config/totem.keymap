//                                                        █   █  █  █   █  █  █   █  █  █   █
//                                                         ▀▀▀   █   ▀▀▀   █   ▀▀▀   ▀   ▀▀▀
//                                                               █      ▄▄▄█▄▄▄    █   █  
//                                                               ▀      █  █  █     █▄█
//                                                             ▀▀▀▀▀    █  █  █      ▀
//                                                                      ▀  ▀  ▀
//
// ▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄

#include "keys_ru.h"
#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>

&mt {
    quick-tap-ms = <150>;
    flavor = "tap-preferred";
};

/ {
    behaviors {
        en_dot: en_dot {
            compatible = "zmk,behavior-mod-morph";
            label = "EN_DOT";
            bindings = <&kp DOT>, <&kp COMMA>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        en_gui_dot: en_gui_dot {
            compatible = "zmk,behavior-hold-tap";
            label = "EN_GUI_DOT";
            bindings = <&kp>, <&en_dot>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <150>;
            require-prior-idle-ms = <150>;
            flavor = "tap-preferred";
        };

        RU_SOFT_HARD_SIGN: RU_SOFT_HARD_SIGN {
            compatible = "zmk,behavior-mod-morph";
            label = "RU_SOFT_HARD_SIGN";
            bindings = <&kp RU_CYRILLIC_SOFT_SIGN>, <&kp RU_CYRILLIC_HARD_SIGN>;

            #binding-cells = <0>;
            mods = <(MOD_LALT|MOD_RALT)>;
        };

        RU_SHCHA_SHCHA: RU_SHCHA_SHCHA {
            compatible = "zmk,behavior-mod-morph";
            label = "RU_SHCHA_SHCHA";
            bindings = <&kp RU_CYRILLIC_SHA>, <&kp RU_CYRILLIC_SHCHA>;

            #binding-cells = <0>;
            mods = <(MOD_LALT|MOD_RALT)>;
        };

        RU_IE_IO: RU_IE_IO {
            compatible = "zmk,behavior-mod-morph";
            label = "RU_IE_IO";
            bindings = <&kp RU_CYRILLIC_IE>, <&kp RU_CYRILLIC_IO>;

            #binding-cells = <0>;
            mods = <(MOD_LALT|MOD_RALT)>;
        };

        BR_SHIFT_CLOSE: BR_SHIFT_CLOSE {
            compatible = "zmk,behavior-mod-morph";
            label = "BR_SHIFT_CLOSE";
            bindings = <&kp LPAR>, <&kp RPAR>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        CBR_SHIFT_CLOSE: CBR_SHIFT_CLOSE {
            compatible = "zmk,behavior-mod-morph";
            label = "CBR_SHIFT_CLOSE";
            bindings = <&kp LBRC>, <&kp RBRC>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        SBR_SHIFT_CLOSE: SBR_SHIFT_CLOSE {
            compatible = "zmk,behavior-mod-morph";
            label = "SBR_SHIFT_CLOSE";
            bindings = <&kp LBKT>, <&kp RBKT>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        TBR_SHIFT_CLOSE: TBR_SHIFT_CLOSE {
            compatible = "zmk,behavior-mod-morph";
            label = "TBR_SHIFT_CLOSE";
            bindings = <&kp LT>, <&kp GT>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        RU_CBR_SHIFT_CLOSE: RU_CBR_SHIFT_CLOSE {
            compatible = "zmk,behavior-mod-morph";
            label = "RU_CBR_SHIFT_CLOSE";
            bindings = <&en LBRC>, <&en RBRC>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        RU_SBR_SHIFT_CLOSE: RU_SBR_SHIFT_CLOSE {
            compatible = "zmk,behavior-mod-morph";
            label = "RU_SBR_SHIFT_CLOSE";
            bindings = <&en LBKT>, <&en RBKT>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        RU_TBR_SHIFT_CLOSE: RU_TBR_SHIFT_CLOSE {
            compatible = "zmk,behavior-mod-morph";
            label = "RU_TBR_SHIFT_CLOSE";
            bindings = <&en LT>, <&en GT>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        sticky_forever: sticky_forever {
            compatible = "zmk,behavior-sticky-key";
            label = "STICKY_FOREVER";
            bindings = <&kp>;
            #binding-cells = <1>;
            release-after-ms = <3000000>;
            quick-release;
            ignore-modifiers;
        };

        mm_wintab: mm_wintab {
            compatible = "zmk,behavior-mod-morph";
            label = "MM_WINTAB";
            bindings = <&wintab>, <&kp TAB>;

            #binding-cells = <0>;
            mods = <(MOD_LALT|MOD_RALT)>;
            keep-mods = <(MOD_LALT|MOD_RALT)>;
        };

        mm_mactab: mm_mactab {
            compatible = "zmk,behavior-mod-morph";
            label = "MM_MACTAB";
            bindings = <&mactab>, <&kp TAB>;

            #binding-cells = <0>;
            mods = <(MOD_LGUI|MOD_RGUI)>;
            keep-mods = <(MOD_LGUI|MOD_RGUI)>;
        };

        PIPE_BS: PIPE_BS {
            compatible = "zmk,behavior-mod-morph";
            label = "PIPE_BS";
            bindings = <&kp PIPE>, <&kp BACKSLASH>;

            #binding-cells = <0>;
            mods = <(MOD_LALT|MOD_RALT)>;
        };

        SL_PIPE_BS: SL_PIPE_BS {
            compatible = "zmk,behavior-mod-morph";
            label = "SL_PIPE_BS";
            bindings = <&kp SLASH>, <&PIPE_BS>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_LALT|MOD_RSFT|MOD_RALT)>;
        };

        COLON_SEMI: COLON_SEMI {
            compatible = "zmk,behavior-mod-morph";
            label = "COLON_SEMI";
            bindings = <&kp COLON>, <&kp SEMI>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        RU_COLON_SEMI: RU_COLON_SEMI {
            compatible = "zmk,behavior-mod-morph";
            label = "RU_COLON_SEMI";
            bindings = <&en COLON>, <&en SEMI>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };
    };

    combos {
        compatible = "zmk,combos";

        cmbru {
            bindings = <&layer_ru>;
            key-positions = <2 3>;
            layers = <0>;
        };

        cmben {
            bindings = <&layer_en>;
            key-positions = <2 3>;
            layers = <1>;
        };
    };

    macros {
        to_ru: to_ru {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LS(LC(N2))>;
            label = "TO_RU";
            wait-ms = <0>;
            tap-ms = <30>;
        };

        to_en: to_en {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LS(LC(N1))>;
            label = "TO_EN";
            wait-ms = <0>;
            tap-ms = <30>;
        };

        layer_ru: layer_ru {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&to 1 &to_ru>;
            label = "LAYER_RU";
            wait-ms = <0>;
            tap-ms = <30>;
        };

        layer_en: layer_en {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&to 0 &to_en>;
            label = "LAYER_EN";
            wait-ms = <0>;
            tap-ms = <30>;
        };

        en: en {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings =
                <&to_en>,
                <&macro_press>,
                <&macro_param_1to1 &kp MACRO_PLACEHOLDER>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&macro_param_1to1 &kp MACRO_PLACEHOLDER>,
                <&macro_tap>,
                <&to_ru>;

            label = "EN";
            wait-ms = <0>;
            tap-ms = <30>;
        };

        wintab: wintab {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_press>, <&kp LEFT_ALT>, <&macro_tap>, <&kp TAB>;

            label = "WINTAB";
        };

        la: la {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings =
                <&macro_press>,
                <&macro_param_1to1 &mo MACRO_PLACEHOLDER>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&macro_param_1to1 &mo MACRO_PLACEHOLDER &kp LEFT_ALT &kp LEFT_GUI>;

            label = "LA";
        };

        mactab: mactab {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_press>, <&kp LEFT_GUI>, <&macro_tap>, <&kp TAB>;

            label = "MACTAB";
        };

        lala: lala {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings =
                <&macro_release>,
                <&kp LEFT_GUI &kp LEFT_ALT &kp LEFT_SHIFT &kp LEFT_CONTROL>,
                <&macro_press>,
                <&macro_param_1to1 &mo MACRO_PLACEHOLDER>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&macro_param_1to1 &mo MACRO_PLACEHOLDER>;

            label = "LALA";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        en {
            bindings = <
                &kp Q  &kp W  &kp E  &kp R  &kp T        &kp Y    &kp U  &kp I             &kp O              &kp P
                &kp A  &kp S  &kp D  &kp F  &kp G        &kp H    &kp J  &kp K             &kp L              &kp SEMI
&mt LSHIFT TAB  &kp Z  &kp X  &kp C  &kp V  &kp B        &kp N    &kp M  &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &kp FSLH  &en_gui_dot LEFT_GUI 0
                              &mo 6  &mo 2  &kp SPACE    &kp RET  &mo 4  &mo 7
            >;

            display-name = "En";
            label = "En";
        };

        ru {
            bindings = <
                &kp RU_CYRILLIC_SHORT_I  &kp RU_CYRILLIC_TSE   &kp RU_CYRILLIC_U   &kp RU_CYRILLIC_KA  &RU_IE_IO             &kp RU_CYRILLIC_EN  &kp RU_CYRILLIC_GHE  &RU_SHCHA_SHCHA     &kp RU_CYRILLIC_ZE  &kp RU_CYRILLIC_HA
                &kp RU_CYRILLIC_EF       &kp RU_CYRILLIC_YERU  &kp RU_CYRILLIC_VE  &kp RU_CYRILLIC_A   &kp RU_CYRILLIC_PE    &kp RU_CYRILLIC_ER  &kp RU_CYRILLIC_O    &kp RU_CYRILLIC_EL  &kp RU_CYRILLIC_DE  &kp RU_CYRILLIC_ZHE
&mt LSHIFT TAB  &kp RU_CYRILLIC_YA       &kp RU_CYRILLIC_CHE   &kp RU_CYRILLIC_ES  &kp RU_CYRILLIC_EM  &kp RU_CYRILLIC_I     &kp RU_CYRILLIC_TE  &RU_SOFT_HARD_SIGN   &kp RU_CYRILLIC_BE  &kp RU_CYRILLIC_YU  &kp RU_CYRILLIC_E    &mt LGUI RU_PERIOD
                                                               &mo 6               &mo 3               &kp SPACE             &kp RET             &mo 5                &mo 7
            >;

            display-name = "Ru";
            label = "Ru";
        };

        lc {
            bindings = <
        &wintab                            &kp EXCLAMATION  &kp EQUAL  &TBR_SHIFT_CLOSE  &kp GRAVE           &trans  &trans  &trans  &trans  &trans
        &kp LGUI                           &kp LALT         &kp LSHFT  &kp LCTRL         &kp SINGLE_QUOTE    &trans  &trans  &trans  &trans  &trans
&trans  &kp C_AC_DESKTOP_SHOW_ALL_WINDOWS  &kp BSPC         &kp ESC    &kp DELETE        &COLON_SEMI         &trans  &trans  &trans  &trans  &trans  &trans
                                                            &trans     &trans            &trans              &trans  &trans  &trans
            >;

            label = "LC";
        };

        ru_lc {
            label = "RU LC";
            bindings = <
        &wintab                            &kp EXCLAMATION  &kp EQUAL  &RU_TBR_SHIFT_CLOSE  &en GRAVE           &trans  &trans  &trans  &trans  &trans
        &kp LGUI                           &kp LALT         &kp LSHFT  &kp LCTRL            &en SINGLE_QUOTE    &trans  &trans  &trans  &trans  &trans
&trans  &kp C_AC_DESKTOP_SHOW_ALL_WINDOWS  &kp BSPC         &kp ESC    &kp DELETE           &RU_COLON_SEMI      &trans  &trans  &trans  &trans  &trans  &trans
                                                            &trans     &trans               &trans              &trans  &trans  &trans
            >;
        };

        rc {
            bindings = <
        &trans  &trans  &trans  &trans  &trans    &TBR_SHIFT_CLOSE  &kp AMPS     &kp AT_SIGN  &kp HASH   &kp DOLLAR
        &trans  &trans  &trans  &trans  &trans    &BR_SHIFT_CLOSE   &kp RCTRL    &kp RSHFT    &kp RALT   &kp RGUI
&trans  &trans  &trans  &trans  &trans  &trans    &CBR_SHIFT_CLOSE  &SL_PIPE_BS  &kp PERCENT  &kp CARET  &kp UNDERSCORE  &trans
                        &trans  &trans  &trans    &trans            &trans       &trans
            >;

            label = "RC";
        };

        ru_rc {
            label = "RU RC";
            bindings = <
        &trans  &trans  &trans  &trans  &trans    &TBR_SHIFT_CLOSE  &en AMPS     &en AT_SIGN  &en HASH   &en DOLLAR
        &trans  &trans  &trans  &trans  &trans    &BR_SHIFT_CLOSE   &kp RCTRL    &kp RSHFT    &kp RALT   &kp RGUI
&trans  &trans  &trans  &trans  &trans  &trans    &CBR_SHIFT_CLOSE  &SL_PIPE_BS  &kp PERCENT  &en CARET  &kp UNDERSCORE  &trans
                        &trans  &trans  &trans    &trans            &trans       &trans
            >;
        };

        num {
            bindings = <
        &kp F1    &kp F2    &kp F3     &kp F4     &kp F5     &kp PLUS   &kp N7  &kp N8  &kp N9  &kp ASTRK
        &kp LGUI  &kp LALT  &kp LSHFT  &kp LCTRL  &kp F12    &kp EQUAL  &kp N4  &kp N5  &kp N6  &kp N0
&kp F6  &kp F7    &kp F8    &kp F9     &kp F10    &kp F11    &kp MINUS  &kp N1  &kp N2  &kp N3  &kp SLASH  &trans
                            &trans     &trans     &trans     &trans     &trans  &trans
            >;

            label = "Num";
        };

        nav {
            bindings = <
        &trans  &trans          &trans          &trans           &trans    &trans  &trans  &trans  &trans  &trans
        &trans  &kp LEFT_ARROW  &kp UP_ARROW    &kp RIGHT_ARROW  &trans    &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans          &kp DOWN_ARROW  &trans           &trans    &trans  &trans  &trans  &trans  &trans  &trans
                                &trans          &trans           &trans    &trans  &trans  &trans
            >;

            label = "Nav";
        };
    };

    conditional_layers { compatible = "zmk,conditional-layers"; };
};
